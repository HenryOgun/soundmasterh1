# Sanity CMS — get these from https://sanity.io/manage
VITE_SANITY_PROJECT_ID=your_project_id_here

# Write token — needed to publish articles/projects from the website admin panel
# Get it from: Sanity dashboard → API → Tokens → Add API token (Editor role)
VITE_SANITY_WRITE_TOKEN=your_write_token_here
